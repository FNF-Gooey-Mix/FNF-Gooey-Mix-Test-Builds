import gooeymix.audio.visualize.FloraSpeakerScreenPixel;
import funkin.play.character.SparrowCharacter;
import funkin.play.PlayState;
import funkin.graphics.FunkinSprite;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.graphics.shaders.DropShadowShader;

using StringTools;

class FloraPixelThornsCharacter extends SparrowCharacter
{
  private static var FLORA_VIS_COLOR:Int = 0xFF82FFFF;
  private static var RED_FLORA_VIS_COLOR:Int = 0xFFFF4973;

  function new()
  {
    super('flora-pixel-thorns'); // gonna do the flora pixel recode once flora's pixel sprites are 100% finished
  }

  var floraSpeaker;
  var visualizerFlora:FloraSpeakerScreenPixel;
  var refershedLol:Bool = false;
  // Shader stuff.
  private var currentShader = null;
  private var adjustColor:AdjustColorShader;

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);

    floraSpeaker = new FunkinSprite(0, 0).loadSparrow('gameplay/characters/flora-pixel/FloraSpeakerPixel');
    floraSpeaker.animation.addByPrefix('blue', 'speaker', 12, false);
    floraSpeaker.animation.addByPrefix('red', 'spirit', 12, false);
    floraSpeaker.animation.play('blue');
    floraSpeaker.animation.curAnim.finish();
    PlayState.instance.currentStage.add(floraSpeaker);
    if (GooeyMixOptions.floraVisualizer)
    {
      visualizerFlora = new FloraSpeakerScreenPixel(0xFFFFFFFF, GooeyMixOptions.floraVisualizer);
      PlayState.instance.currentStage.add(visualizerFlora);
    }
  }

  function onSongStart(scriptEvent)
  {
    super.onSongStart(scriptEvent);
    if (GooeyMixOptions.floraVisualizer) visualizerFlora?.initAnalyzer(FlxG.sound.music);
  }

  function onSongRetry(scriptEvent)
  {
    super.onSongRetry(scriptEvent);
    if (GooeyMixOptions.floraVisualizer) analyzer = null;
  }

  function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);
    if (!refershedLol)
    {
      floraSpeaker.zIndex = this.zIndex - 1;
      floraSpeaker.scale.set(6, 6);
      floraSpeaker.antialiasing = false;
      floraSpeaker?.setPosition(this.x + 163 - (-this.globalOffsets[0] * this.scale.x), this.y + 158 - (-this.globalOffsets[1] * this.scale.y));

      if (GooeyMixOptions.floraVisualizer)
      {
        visualizerFlora.x = floraSpeaker.x + 17;
        visualizerFlora.y = floraSpeaker.y + 16;
        visualizerFlora.zIndex = floraSpeaker.zIndex + 1;
        visualizerFlora.antialiasing = false;
      }

      PlayState.instance.currentStage.add(floraSpeaker);
      PlayState.instance.currentStage.refresh();
      refershedLol = true;
      synchronizeShader();
    }
  }

  function synchronizeShader():Void
  {
    if (GooeyMixOptions.gooeyShaders)
    {
      if (currentShader == this.shader) return;

      currentShader = this.shader;

      if (Std.isOfType(this.shader, DropShadowShader))
      {
        adjustColor = new AdjustColorShader();
        adjustColor.brightness = this.shader.baseBrightness;
        adjustColor.hue = this.shader.baseHue;
        adjustColor.contrast = this.shader.baseContrast;
        adjustColor.saturation = this.shader.baseSaturation;
        floraSpeaker.shader = adjustColor;
        visualizerFlora.shader = adjustColor;
      }
      else
      {
        floraSpeaker.shader = this.shader;
        visualizerFlora.shader = this.shader;
      }

      trace("Synchronized shader between children!");
    }
  }

  function retroFloor(value:Float):Float
  {
    return Math.floor(value / 6) * 6;
  }

  override public function playAnimation(name:String, restart:Bool = false, ?ignoreOther:Bool = false, ?reversed:Bool = false)
  {
    super.playAnimation(name, restart, ignoreOther, reversed);
    if (floraSpeaker == null) return;
    if (name == "danceLeft")
    {
      if (GooeyMixOptions.floraVisualizer) visualizerFlora.color = FLORA_VIS_COLOR;
      floraSpeaker?.animation.play('blue', true);
    }
    else if (name == "danceRight")
    {
      if (GooeyMixOptions.floraVisualizer) visualizerFlora.color = RED_FLORA_VIS_COLOR;
      floraSpeaker?.animation.play('red', true);
    }
  }
}

import funkin.ui.freeplay.dj.AnimateAtlasFreeplayDJ;
import funkin.ui.freeplay.FreeplayState;

using StringTools;

class GooeyFreeplayDJ extends AnimateAtlasFreeplayDJ
{
  public function new(x:Float, y:Float, characterId:String)
  {
    super(x, y, characterId);
  }

  public function onFreeplayIntroDone(event:FreeplayScriptEvent):Void
  {
    super.onFreeplayIntroDone(event);
    // Set Gooey above the background to prevent Morpho from being cropped
    FlxG.state.subState.members.remove(super);
    FlxG.state.subState.members.insert(FlxG.state.subState.members.indexOf(FlxG.state.subState.backingImage) + 1, super);
  }
}

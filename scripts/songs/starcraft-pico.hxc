import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.util.FlxTweenUtil;

class StarcraftPicoMixSong extends Song
{
  function new()
  {
    super('starcraft', {
      variation: 'pico'
    });
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    blackScreen = new FlxSprite(-100, -100).makeGraphic(FlxG.width * 2, FlxG.height * 2, 0xFF000000);
    blackScreen.cameras = [PlayState.instance.camHUD];
    PlayState.instance.add(blackScreen);
    if (PlayState.instance.isChartingMode) blackScreen.alpha = 0;
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    if (blackScreen != null) FlxTween.cancelTweensOf(blackScreen);
    if (!PlayState.instance.isChartingMode) blackScreen.alpha = 1;
  }

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (event.step == 4) FlxTween.tween(blackScreen, {alpha: 0}, 1);
  }

  function onPause(event:ScriptEvent)
  {
    super.onPause(event);
    if (blackScreen != null) FlxTweenUtil.pauseTweensOf(blackScreen);
  }

  function onResume(event:ScriptEvent)
  {
    super.onResume(event);
    if (blackScreen != null) FlxTweenUtil.resumeTweensOf(blackScreen);
  }
}

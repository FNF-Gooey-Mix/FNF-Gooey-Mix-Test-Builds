import funkin.play.stage.Stage;
import funkin.graphics.shaders.DropShadowShader;
import funkin.play.character.CharacterType;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import flixel.util.FlxTimerManager;
import funkin.play.PlayState;
import flixel.util.FlxSave;
import funkin.graphics.FunkinSprite;
import funkin.audio.FunkinSound;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.play.PlayStatePlaylist;
import funkin.util.TouchUtil;
import funkin.util.Sequence;
import funkin.Conductor;
import funkin.data.song.SongRegistry;
import funkin.graphics.shaders.AdjustColorShader;

class NatCrystalStage extends Stage
{
  function new()
  {
    super('natCrystal');
  }

  public function onGameOver(event:ScriptEvent)
  {
    super.onGameOver(event);
    if (GooeyMixOptions.gooeyShaders)
    {
      getBoyfriend().shader = null;
    }
  }

  var crystalTween1:FlxTween;
  var crystalTween2:FlxTween;
  var crystalTween3:FlxTween;
  var crystalTween4:FlxTween;
  var crystalTween5:FlxTween;
  var crystalEffectAlpha = 0;

  function buildStage()
  {
    super.buildStage();

    if (PlayState.instance.currentSong.id.toLowerCase() == "starcraft") crystalEffectAlpha = 0.0001;
    else
      crystalEffectAlpha = 0; // make textures only load if the song is starcraft

    for (broWeek8 in [
      'natCrystalLight2',
      'overlay3',
      'backWallLights',
      'bottomCrystalLight2',
      'crystalReflections1',
      'crystalReflections2',
      'starcraftLight',
      'crystalBackWall'
    ]) getNamedProp(broWeek8).alpha = crystalEffectAlpha;

    addTweens();
  }

  function addTweens()
  {
    crystalTween1 = FlxTween.tween(getNamedProp('natCrystalLight'), {y: getNamedProp('natCrystalLight').y + 50}, 5, {ease: FlxEase.quadInOut, type: 4});
    crystalTween2 = FlxTween.tween(getNamedProp('natCrystal'), {y: getNamedProp('natCrystal').y + 50}, 5, {ease: FlxEase.quadInOut, type: 4});

    if (PlayState.instance.currentSong.id.toLowerCase() == "starcraft")
    {
      crystalTween3 = FlxTween.tween(getNamedProp('natCrystalLight2'), {y: getNamedProp('natCrystalLight2').y + 50}, 5, {ease: FlxEase.quadInOut, type: 4});
      crystalTween4 = FlxTween.tween(getNamedProp('crystalReflections1'), {angle: 360}, 30, {type: 2});
      crystalTween5 = FlxTween.tween(getNamedProp('crystalReflections2'), {angle: -360}, 40, {type: 2});
    }
  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    super.addCharacter(character, charType);

    if (charType == CharacterType.GF && character.characterId == 'gf')
    {
      character.originalPosition.x = character.x += 60;
      character.originalPosition.y = character.y -= 20;
      character.resetCameraFocusPoint(); // move gfs fatass from being offsetted wrong
    }
    // Apply the shader automatically to each character as it gets added.
    trace('Applied stage shader to ' + character.characterName);
    if (GooeyMixOptions.gooeyShaders)
    {
      var rim = new DropShadowShader();
      rim.setAdjustColor(-80, -24, -5, -10);
      rim.color = 0xFFEF72F9;
      character.shader = rim;
      rim.attachedSprite = character;

      switch (charType)
      {
        case CharacterType.BF:
          rim.angle = 112.5;
          character.animation.onFrameChange.add(function()
          {
            if (getBoyfriend() != null)
            {
              rim.updateFrameInfo(getBoyfriend().frame);
            }
          });
        case CharacterType.GF:
          rim.angle = 90;
          character.animation.onFrameChange.add(function()
          {
            rim.updateFrameInfo(getGirlfriend().frame);
          });
        case CharacterType.DAD:
          rim.angle = 112.5;
          character.animation.onFrameChange.add(function()
          {
            rim.updateFrameInfo(getDad().frame);
          });
        default:
      }
    }
  }

  function onPause(ev)
  {
    super.onPause(ev);
    // False...
    for (twn in [crystalTween1, crystalTween2]) twn.active = false;
    if (PlayState.instance.currentSong.id.toLowerCase() == "starcraft")
    {
      for (twn in [crystalTween3, crystalTween4, crystalTween5]) twn.active = false;
    }
  }

  function onResume(ev)
  {
    super.onResume(ev);
    // True...
    for (twn in [crystalTween1, crystalTween2]) twn.active = true;
    if (PlayState.instance.currentSong.id.toLowerCase() == "starcraft")
    {
      for (twn in [crystalTween3, crystalTween4, crystalTween5]) twn.active = true;
    }
  }

  // CUTSCENE STUFF -------------------------------------------------------------------------------------------
  var hasPlayedCutscene:Bool = false;
  var cutsceneSkipped:Bool = false;
  var canSkipCutscene:Bool = false;
  var gooeyCutSound:FunkinSound;
  var isMobilePauseButtonPressed:Bool = false;
  var songIntro:FunkinSound;
  var fakeOpponent:FunkinSprite;
  var fakePlayer:FunkinSprite;
  var gorse:FunkinSprite;

  /**
   * Replay the cutscene after leaving the song.
   */
  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    hasPlayedCutscene = false;
    cutsceneSkipped = false;
    canSkipCutscene = false;
    isMobilePauseButtonPressed = false;
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    if (!PlayState.instance.currentStage.getBoyfriend()?.characterId == 'gooey' || PlayState.instance.currentVariation != 'gooey')
    {
      hasPlayedCutscene = true;
      cutsceneSkipped = true;
    }

    if (!hasPlayedCutscene)
    {
      trace('Pausing countdown to play a cutscene (`gooey gooey`)');

      hasPlayedCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!
      gooeyGooeyCut();
    }
  }

  var gooeyCutSequenceData:Array<SequenceData>;
  var cutsceneConductor:Conductor;

  private inline function onCutsceneBeatHit():Void
  {
    PlayState.instance.currentStage.getGirlfriend().dance(false);
  }

  function gooeyGooeyCut()
  {
    skipText = new FlxText(936, 618, 0, 'Skip [ ' + PlayState.instance.controls.getDialogueNameFromToken("CUTSCENE_ADVANCE", true) + ' ]', 20);
    skipText.setFormat(Paths.font('vcr.ttf'), 40, 0xFFFFFFFF, "right", FlxTextBorderStyle.OUTLINE, 0xFF000000);
    skipText.scrollFactor.set();
    skipText.borderSize = 2;
    skipText.alpha = 0;
    PlayState.instance.currentStage.add(skipText);

    skipText.cameras = [PlayState.instance.camCutscene];

    PlayState.instance.camHUD.alpha = 0;

    PlayState.instance.currentStage.getDad().visible = false;
    PlayState.instance.currentStage.getBoyfriend().visible = false;

    rightStartCamera = FlxG.random.bool(50);
    gorseCutscene = FlxG.random.bool(6.0037);

    fakeOpponent = FunkinSprite.createTextureAtlas(0, 0, 'characters/gooey/GooeyGooeyCutscene', "shared");
    fakeOpponent.anim.addByFrameLabel('opponentSit', 'opponentSit', 24, false);
    fakeOpponent.anim.addByFrameLabel('opponentLook', 'opponentLook', 24, false);
    fakeOpponent.anim.addByFrameLabel('opponentCutscene', 'opponentCutscene', 24, false);
    fakeOpponent.anim.addByFrameLabel('opponentPosRef', 'opponentPosRef', 24, false);
    fakeOpponent.anim.addByFrameLabel('GorseLook', 'GorseLook', 24, false);
    fakeOpponent.anim.addByFrameLabel('GorseKillsGooey', 'GorseKillsGooey', 24, false);
    fakeOpponent.animation.play('opponentSit');
    PlayState.instance.currentStage.add(fakeOpponent);
    fakeOpponent.setPosition(1223, 162);
    fakeOpponent.zIndex = 62;
    if (GooeyMixOptions.gooeyShaders)
    {
      var rim = new DropShadowShader();
      rim.setAdjustColor(-80, -24, -5, -10);
      rim.color = 0xFFEF72F9;
      fakeOpponent.shader = rim;
      rim.attachedSprite = fakeOpponent;
      rim.angle = 112.5;
      rim.threshold = 0.2;
      fakeOpponent.animation.onFrameChange.add(function()
      {
        rim.updateFrameInfo(fakeOpponent.frame);
      });
    }

    if (!gorseCutscene)
    {
      fakePlayer = FunkinSprite.createTextureAtlas(0, 0, 'characters/gooey/GooeyGooeyCutscene', "shared");
      fakePlayer.anim.addByFrameLabel('playerSit', 'playerSit', 24, false);
      fakePlayer.anim.addByFrameLabel('playerLook', 'playerLook', 24, false);
      fakePlayer.anim.addByFrameLabel('playerCutscene', 'playerCutscene', 24, false);
      fakePlayer.anim.addByFrameLabel('playerPosRef', 'playerPosRef', 24, false);
      fakePlayer.animation.play('playerSit');
      PlayState.instance.currentStage.add(fakePlayer);
      fakePlayer.setPosition(1220, 162);
      fakePlayer.zIndex = 61;
      if (GooeyMixOptions.gooeyShaders)
      {
        var rim = new DropShadowShader();
        rim.setAdjustColor(-80, -24, -5, -10);
        rim.color = 0xFFEF72F9;
        fakePlayer.shader = rim;
        rim.attachedSprite = fakePlayer;
        rim.angle = 67.5;
        rim.threshold = 0.2;
        fakePlayer.animation.onFrameChange.add(function()
        {
          rim.updateFrameInfo(fakePlayer.frame);
        });
      }
    }

    if (gorseCutscene)
    {
      gorse = new FunkinSprite(0, 0).loadTexture('characters/gooey/gorse', 'shared');
      gorse.setPosition(1210, 15);
      gorse.zIndex = 63;
      PlayState.instance.currentStage.add(gorse);
      if (GooeyMixOptions.gooeyShaders)
      {
        var rim = new DropShadowShader();
        rim.setAdjustColor(-80, -24, -5, -10);
        rim.color = 0xFFEF72F9;
        gorse.shader = rim;
        rim.attachedSprite = gorse;
        rim.angle = 67.5;
        rim.threshold = 0.2;
      }
    }

    var leftPos:Array<Float> = [
      PlayState.instance.currentStage.getDad().cameraFocusPoint.x,
      PlayState.instance.currentStage.getDad().cameraFocusPoint.y
    ];
    var rightPos:Array<Float> = [
      PlayState.instance.currentStage.getBoyfriend().cameraFocusPoint.x,
      PlayState.instance.currentStage.getBoyfriend().cameraFocusPoint.y
    ];
    var floraPos:Array<Float> = [
      PlayState.instance.currentStage.getGirlfriend().cameraFocusPoint.x,
      PlayState.instance.currentStage.getGirlfriend().cameraFocusPoint.y
    ];

    PlayState.instance.currentStage.refresh();
    PlayState.instance.isInCutscene = true;

    if (gorseCutscene)
    {
      gooeyCutSequenceData = [
        {
          time: 0,
          callback: () ->
          {
            PlayState.instance.tweenCameraToPosition(rightPos[0] + 0, rightPos[1] + 0, 0, FlxEase.expoOut);
            PlayState.instance.tweenCameraToPosition(rightPos[0] + 150, rightPos[1] + 100, 3, FlxEase.expoOut);
            PlayState.instance.tweenCameraZoom(1.3, 0, true);
            FlxG.camera.fade(0xFF000000, 1, true);
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/caveShimmer'), 1.0);
          }
        },
        {
          time: 2.6,
          callback: () ->
          {
            cutsceneConductor = new Conductor();
            songIntro = FunkinSound.load(Paths.music("cutscene/gooeyGooeyMix", "shared"), true);
            songIntro.play();
            var songMusicData = SongRegistry.instance.parseMusicData("cutscene/gooeyGooeyMix", "shared");
            if (songMusicData != null) cutsceneConductor.mapTimeChanges(songMusicData.timeChanges);
            cutsceneConductor.onBeatHit.add(onCutsceneBeatHit);
          }
        },
        {
          time: 3,
          callback: () ->
          {
            fakeOpponent.animation.play('opponentLook');
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/gooeyNotice1'), 1.0);
          }
        },
        {
          time: 3.1,
          callback: () ->
          {
            PlayState.instance.tweenCameraZoom(1.2, 1, true, FlxEase.expoOut);
          }
        },
        {
          time: 4.5,
          callback: () ->
          {
            fakeOpponent.animation.play('GorseLook');
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/gorseLook'), 1.0);
            FlxTween.tween(songIntro, {pitch: 0.2}, 4, null, FlxEase.smoothStepInOut);
            canSkipCutscene = false;
            skipText.visible = false;
          }
        },
        {
          time: 5,
          callback: () ->
          {
            PlayState.instance.tweenCameraToPosition(floraPos[0] + 50, floraPos[1], 5, FlxEase.smoothStepInOut);
            PlayState.instance.tweenCameraZoom(0.6, 5, true, FlxEase.smoothStepInOut);
          }
        },
        {
          time: 6.5,
          callback: () ->
          {
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/gorse'), 0.6);
          }
        },
        {
          time: 11,
          callback: () ->
          {
            FlxTween.tween(gorse, {x: gorse.x + 800}, 3, {ease: FlxEase.expoIn});
            PlayState.instance.tweenCameraZoom(0.7, 3, true, FlxEase.expoIn);
          }
        },
        {
          time: 12,
          callback: () ->
          {
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/gorseKills'), 1.0);
            songIntro.fadeOut(1, 0);
          }
        },
        {
          time: 13,
          callback: () ->
          {
            fakeOpponent.animation.play('GorseKillsGooey');
          }
        },
        {
          time: 13.9,
          callback: () ->
          {
            FlxG.camera.fade(0xFF000000, 0, false);
          }
        },
        {
          time: 19,
          callback: () ->
          {
            hasPlayedCutscene = true;
            cutsceneSkipped = true;
            PlayState.instance.isInCutscene = false;
            PlayState.instance.endSong(true);
          }
        },
      ];
    }
    else if (rightStartCamera)
    {
      gooeyCutSequenceData = [
        {
          time: 0,
          callback: () ->
          {
            PlayState.instance.tweenCameraToPosition(rightPos[0] + 0, rightPos[1] + 0, 0, FlxEase.expoOut);
            PlayState.instance.tweenCameraToPosition(rightPos[0] + 150, rightPos[1] + 100, 3, FlxEase.expoOut);
            PlayState.instance.tweenCameraZoom(1.3, 0, true);
            FlxG.camera.fade(0xFF000000, 1, true);
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/caveShimmer'), 1.0);
          }
        },
        {
          time: 2.6,
          callback: () ->
          {
            cutsceneConductor = new Conductor();
            songIntro = FunkinSound.load(Paths.music("cutscene/gooeyGooeyMix", "shared"), true);
            songIntro.play();
            var songMusicData = SongRegistry.instance.parseMusicData("cutscene/gooeyGooeyMix", "shared");
            if (songMusicData != null) cutsceneConductor.mapTimeChanges(songMusicData.timeChanges);
            cutsceneConductor.onBeatHit.add(onCutsceneBeatHit);
          }
        },
        {
          time: 3,
          callback: () ->
          {
            fakeOpponent.animation.play('opponentLook');
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/gooeyNotice1'), 1.0);
          }
        },
        {
          time: 3.1,
          callback: () ->
          {
            PlayState.instance.tweenCameraZoom(1.2, 1, true, FlxEase.expoOut);
          }
        },
        {
          time: 3.6,
          callback: () ->
          {
            PlayState.instance.tweenCameraToPosition(floraPos[0] + 50, floraPos[1], 3, FlxEase.expoOut);
            PlayState.instance.tweenCameraZoom(0.6, 3, true, FlxEase.expoOut);
          }
        },
        {
          time: 4.1,
          callback: () ->
          {
            fakePlayer.animation.play('playerLook');
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/gooeyNotice2'), 1.0);
          }
        },
        {
          time: 5.8,
          callback: () ->
          {
            PlayState.instance.tweenCameraZoom(0.7, 5, true, FlxEase.expoOut);
            PlayState.instance.tweenCameraToPosition(floraPos[0] + 50, floraPos[1] + 40, 3, FlxEase.expoOut);
            fakePlayer.animation.play('playerCutscene');
            fakeOpponent.animation.play('opponentCutscene');
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/walkAndWave'), 1.0);
          }
        },
        {
          time: 6.55,
          callback: () ->
          {
            if (GooeyMixOptions.gooeyShaders)
            {
              fakeOpponent.shader.angle = 67.5;
              fakePlayer.shader.angle = 112.5;
            }
          }
        },
        {
          time: 8.3,
          callback: () ->
          {
            PlayState.instance.tweenCameraToPosition(floraPos[0] + 50, floraPos[1], 3, FlxEase.expoOut);
            PlayState.instance.tweenCameraZoom(0.55, 3, true, FlxEase.expoOut);
          }
        },
        {
          time: 10.5,
          callback: () ->
          {
            PlayState.instance.tweenCameraZoom(0.6, 3, true, FlxEase.expoOut);

            canSkipCutscene = false;
            hasPlayedCutscene = true;
            cutsceneSkipped = true;
            PlayState.instance.isInCutscene = false;
            skipText.visible = false;

            PlayState.instance.startCountdown();
            FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, 1);

            PlayState.instance.currentStage.getDad().visible = true;
            PlayState.instance.currentStage.getBoyfriend().visible = true;
            fakeOpponent.destroy();
            fakePlayer.destroy();
          }
        },
      ];
    }
    else
    {
      gooeyCutSequenceData = [
        {
          time: 0,
          callback: () ->
          {
            PlayState.instance.tweenCameraToPosition(leftPos[0] - 150, leftPos[1] + 100, 3, FlxEase.expoOut);
            PlayState.instance.tweenCameraZoom(1.3, 0, true);
            FlxG.camera.fade(0xFF000000, 1, true);
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/caveShimmer'), 1.0);
          }
        },
        {
          time: 2.6,
          callback: () ->
          {
            cutsceneConductor = new Conductor();
            songIntro = FunkinSound.load(Paths.music("cutscene/gooeyGooeyMix", "shared"), true);
            songIntro.play();
            var songMusicData = SongRegistry.instance.parseMusicData("cutscene/gooeyGooeyMix", "shared");
            if (songMusicData != null) cutsceneConductor.mapTimeChanges(songMusicData.timeChanges);
            cutsceneConductor.onBeatHit.add(onCutsceneBeatHit);
          }
        },
        {
          time: 3,
          callback: () ->
          {
            fakePlayer.animation.play('playerLook');
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/gooeyNotice1'), 1.0);
          }
        },
        {
          time: 3.1,
          callback: () ->
          {
            PlayState.instance.tweenCameraZoom(1.2, 1, true, FlxEase.expoOut);
          }
        },
        {
          time: 3.6,
          callback: () ->
          {
            PlayState.instance.tweenCameraToPosition(floraPos[0] + 50, floraPos[1], 3, FlxEase.expoOut);
            PlayState.instance.tweenCameraZoom(0.6, 3, true, FlxEase.expoOut);
          }
        },
        {
          time: 4.1,
          callback: () ->
          {
            fakeOpponent.animation.play('opponentLook');
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/gooeyNotice2'), 1.0);
          }
        },
        {
          time: 5.8,
          callback: () ->
          {
            PlayState.instance.tweenCameraZoom(0.7, 5, true, FlxEase.expoOut);
            PlayState.instance.tweenCameraToPosition(floraPos[0] + 50, floraPos[1] + 40, 3, FlxEase.expoOut);
            fakePlayer.animation.play('playerCutscene');
            fakeOpponent.animation.play('opponentCutscene');
            gooeyCutSound = FunkinSound.playOnce(Paths.sound('gooeyCutscene/gooeyGooey/walkAndWave'), 1.0);
          }
        },
        {
          time: 6.55,
          callback: () ->
          {
            if (GooeyMixOptions.gooeyShaders)
            {
              fakeOpponent.shader.angle = 67.5;
              fakePlayer.shader.angle = 112.5;
            }
          }
        },
        {
          time: 8.3,
          callback: () ->
          {
            PlayState.instance.tweenCameraToPosition(floraPos[0] + 50, floraPos[1], 3, FlxEase.expoOut);
            PlayState.instance.tweenCameraZoom(0.55, 3, true, FlxEase.expoOut);
          }
        },
        {
          time: 10.5,
          callback: () ->
          {
            PlayState.instance.tweenCameraZoom(0.6, 3, true, FlxEase.expoOut);

            canSkipCutscene = false;
            hasPlayedCutscene = true;
            cutsceneSkipped = true;
            PlayState.instance.isInCutscene = false;
            skipText.visible = false;

            PlayState.instance.startCountdown();
            FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, 1);

            PlayState.instance.currentStage.getDad().visible = true;
            PlayState.instance.currentStage.getBoyfriend().visible = true;
            fakeOpponent.destroy();
            fakePlayer.destroy();
          }
        },
      ];
    }

    gooeyCutSequence = new Sequence(gooeyCutSequenceData);
  }

  function skipCutscene()
  {
    cutsceneSkipped = true;
    hasPlayedCutscene = true;
    PlayState.instance.camCutscene.fade(0xFF000000, 0.5, false, null, true);
    if (songIntro != null) songIntro.fadeOut(0.5, 0);
    if (gooeyCutSound != null) gooeyCutSound.fadeOut(0.5, 0);
    new FlxTimer().start(0.5, _ ->
    {
      PlayState.instance.justUnpaused = true;
      PlayState.instance.camCutscene.fade(0xFF000000, 0.5, true, null, true);

      gooeyCutSequence.destroy();
      if (songIntro != null) songIntro.stop();
      if (gooeyCutSound != null) gooeyCutSound.stop();

      PlayState.instance.startCountdown();
      skipText.visible = false;

      PlayState.instance.currentStage.getDad().visible = true;
      PlayState.instance.currentStage.getBoyfriend().visible = true;
      fakeOpponent.destroy();
      if (fakePlayer != null) fakePlayer.destroy();
      if (gorse != null) gorse.destroy();

      var floraPos:Array<Float> = [
        PlayState.instance.currentStage.getGirlfriend().cameraFocusPoint.x,
        PlayState.instance.currentStage.getGirlfriend().cameraFocusPoint.y
      ];

      PlayState.instance.tweenCameraToPosition(floraPos[0] + 50, floraPos[1], 3, FlxEase.expoOut);
      PlayState.instance.tweenCameraZoom(0.6, 3, true, FlxEase.expoOut);
      FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, 1);
    });
  }

  function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);

    if (PlayState.instance.isInCutscene && cutsceneConductor != null)
    {
      cutsceneConductor.update(songIntro.time);
    }

    if (FlxG.onMobile)
    {
      isMobilePauseButtonPressed = TouchUtil.overlapsComplex(PlayState.instance.pauseButton) && TouchUtil.justPressed;
    }

    if ((PlayState.instance.controls.CUTSCENE_ADVANCE || isMobilePauseButtonPressed) && !cutsceneSkipped)
    {
      if (!canSkipCutscene)
      {
        trace('cant skip yet!');
        if (skipText != null)
        {
          FlxTween.tween(skipText, {alpha: 1}, 0.5, {ease: FlxEase.quadOut});
          new FlxTimer().start(0.5, _ ->
          {
            canSkipCutscene = true;
            trace('can skip!');
          });
        }
      }
    }
    if ((PlayState.instance.controls.CUTSCENE_ADVANCE || isMobilePauseButtonPressed) && !cutsceneSkipped && canSkipCutscene)
    {
      skipCutscene();
      trace('skipped');
    }
  }
}
